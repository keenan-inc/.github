{
  "$meta": {
    "name": "keenan-inc",
    "version": "1.0.0",
    "accent": "teal",
    "note": "Org brand tokens. Reuse verbatim in app UIs so products and org stay coherent."
  },
  "color": {
    "accent": {
      "light": "#0F6E63",
      "dark": "#2FA694",
      "pressLight": "#0A5049",
      "pressDark": "#43BFAC",
      "subtleLight": "#E6F1EF",
      "subtleDark": "#0B2B27"
    },
    "ink": {
      "500": "#484F58",
      "600": "#30363D",
      "700": "#21262D",
      "800": "#161B22",
      "900": "#0D1117"
    },
    "gray": {
      "200": "#C9D1D9",
      "300": "#A7B0BA",
      "400": "#8B949E",
      "500": "#6E7681"
    },
    "paper": {
      "0": "#FFFFFF",
      "25": "#F6F8FA",
      "50": "#F0F3F6",
      "100": "#E6E8EB",
      "200": "#D8DBDF"
    },
    "text": {
      "onDark": "#F0F3F6",
      "onDarkMuted": "#8B949E",
      "onLight": "#14181D",
      "onLightMuted": "#5B6570"
    },
    "state": {
      "ok": "#2FA694",
      "warn": "#C9A227",
      "risk": "#C4534B",
      "info": "#7D6BB0"
    }
  },
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "type": {
    "wordmark": {
      "weight": 500,
      "tracking": "-0.02em"
    },
    "label": {
      "family": "mono",
      "size": "11px",
      "tracking": "0.22em",
      "case": "uppercase"
    }
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "space": {
    "unit": "4px",
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ]
  }
}
